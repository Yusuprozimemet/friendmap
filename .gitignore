# --- secrets --------------------------------------------------------------
# .env holds live API keys (NIM, Resend, Google) and the two durable secrets.
# The negation keeps the committed template, which has every value blank.
.env
.env.*
!.env.example

# --- python ---------------------------------------------------------------
# Replaces GitHub's Python template, which this repo started from. The template
# covers no JavaScript at all — it would have committed web/node_modules — so
# the list below is the union: everything actually produced here, plus the
# template's packaging and coverage entries worth keeping.
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
.venv/
venv/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# --- node -----------------------------------------------------------------
node_modules/
web/dist/
web/tsconfig.tsbuildinfo

# --- tool caches ----------------------------------------------------------
# pytest and ruff each drop a self-ignoring .gitignore into their cache, but
# that's a convenience of the current versions rather than a guarantee, so
# they're named here too.
.pytest_cache/
.ruff_cache/
coverage/
*.lcov

# --- runtime output -------------------------------------------------------
# The daily ingest appends here (and rotates at 5 MB); useful locally, never
# worth committing.
backend/logs/
*.log

# --- local scratch --------------------------------------------------------
# A backfill payload scraped locally. It's other people's post text: it stays
# on the machine that scraped it and out of a public repo.
friends.json

# --- editors / OS ---------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db