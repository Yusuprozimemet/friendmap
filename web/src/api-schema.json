    "/api/me/export": {
      "get": {
        "description": "Everything this account holds, as JSON. GDPR Art. 20 (portability).\n\nDeliberately the raw rows rather than a rendered view: the point is that\nthe data leaves in a form another tool can read, not that it looks nice.\n\nNote what is *not* here — the people on the map. Their entries are not this\nuser's personal data, and a saved list is exported as the opaque\n`person_key` plus whatever note the user wrote themselves. Exporting other\npeople's profiles because someone bookmarked them would turn a portability\nrequest into a data dump about third parties.",
        "operationId": "export_my_data_api_me_export_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Export My Data Api Me Export Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Export My Data",
        "tags": [
          "me"
        ]
      }
    },
