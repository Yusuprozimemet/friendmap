# Copy to .env and fill in. In containers real env vars win over this file, so
# the same names are what Render and the CI workflows set — see README,
# "Deploying to Render".
#
# A managed host's plain postgres:// / postgresql:// URL is accepted as-is;
# config.py rewrites it to the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://friendmap:friendmap@localhost:5433/friendmap

# Set to true only when something in front of the app appends X-Forwarded-For
# (Render, any CDN). It's what makes the per-IP rate limit meter real clients
# instead of the proxy. On a directly reachable host, leave it false: the
# header is client-controlled and would hand out a per-request identity.
TRUST_PROXY=false

# NVIDIA NIM — used only by the ingest extractor, not by the API.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Scraper
SUBREDDITS=makenewfriendsNL,Vriendenmaken
REDDIT_USER_AGENT=friendmap-nl/1.0 (daily subreddit digest)

# API rate limit per client IP. Burst is the immediate allowance; RPM is the
# refill rate. Raise if several people share an outbound IP.
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=60

# --- Sign in with Google (optional) --------------------------------------
# Leave blank to disable: the app runs anonymously and hides the button.
# Create an OAuth 2.0 Client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials and register
# OAUTH_REDIRECT_URL below as an Authorised redirect URI, verbatim.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:5173/api/auth/google/callback
WEB_ORIGIN=http://localhost:5173
# Signs the session cookie, and the unsubscribe links in alert emails — so
# the API and the ingest job must carry the *same* value or every link in
# every digest fails to verify. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out.
SESSION_SECRET=

# DURABLE — saved people and notes key off this. Rotating it orphans every
# saved row, so treat it like the database password, not a cache key.
# Required whenever Google sign-in is enabled.
PERSON_KEY_SECRET=

# --- Email alerts (Spec 3) ------------------------------------------------
# console | smtp | resend. console prints instead of sending — the safe
# default, so nothing goes out before you have picked a transport.
MAIL_BACKEND=console
MAIL_FROM=FriendMap NL <alerts@example.com>
# For MAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
# For MAIL_BACKEND=resend
RESEND_API_KEY=
MAX_SAVED_SEARCHES=5
